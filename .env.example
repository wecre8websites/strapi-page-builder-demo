# Copy to .env and fill in the two secrets. Server-side only: never prefix them with NEXT_PUBLIC_.

# Read-only API token: Strapi Admin > Settings > API Tokens (http://localhost:1337/admin/settings/api-tokens)
STRAPI_ADMIN_TOKEN=

# Free Page Builder licence key: https://pagebuilder.wc8.io
PAGE_BUILDER_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:1337/api
NEXT_PUBLIC_IMAGE_URL=http://localhost:1337
